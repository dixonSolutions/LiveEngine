{
  "$schema": "https://mintlify.com/docs.json",
  "name": "LiveEngine",
  "theme": "mint",
  "description": "Live infrastructure in one package: hub hosting and registry, nested central hubs, pairing, hub-relayed live rooms, direct WebRTC with relay fallback, live hub lists, accounts and pluggable hub auth, for Rust and Node.js.",
