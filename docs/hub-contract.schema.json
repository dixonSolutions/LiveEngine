{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dixonSolutions/LiveEngine/blob/main/docs/hub-contract.schema.json",
  "title": "LiveEngine Hub Protocol v1",
  "description": "Uniform DTOs for internal handlers and externally hosted hubs. Registration and discovery happen at runtime.",
  "$defs": {
    "HubMode": {
      "type": "string",
      "enum": [
        "internal",
        "external"
      ]
    },
    "HubRegistration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}$",
          "not": {
            "enum": [
              ".",
              ".."
            ]
          }
        },
        "mode": {
          "$ref": "#/$defs/HubMode"
        },
        "address": {
          "type": "string",
          "format": "uri"
        },
        "remoteHubId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}$",
          "not": {
            "enum": [
              ".",
              ".."
            ]
          }
        },
        "remoteToken": {
          "type": "string",
          "minLength": 24,
          "writeOnly": true
        },
        "scopes": {
          "type": "object",
          "additionalProperties": true,
          "default": {}
        },
        "scopeSchema": {
          "description": "JSON Schema draft 2020-12 for scopes; only local references are allowed.",
          "type": [
            "object",
            "boolean"
          ]
        },
        "ttlSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "schemaRef": {
          "type": "string"
        },
        "userSchema": {
          "type": [
            "object",
            "boolean"
          ]
        },
        "serverSchema": {
          "type": [
            "object",
            "boolean"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "external"
              }
            }
          },
          "then": {
            "required": [
              "address",
              "remoteToken"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "address"
                  ]
                },
                {
                  "required": [
                    "remoteHubId"
                  ]
                },
                {
                  "required": [
                    "remoteToken"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "HubInfo": {
      "type": "object",
      "required": [
        "id",
        "mode",
        "scopes",
        "remoteHubId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}$",
          "not": {
            "enum": [
              ".",
              ".."
            ]
          }
        },
        "mode": {
          "$ref": "#/$defs/HubMode"
        },
        "address": {
          "type": "string",
          "format": "uri"
        },
        "remoteHubId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}$",
          "not": {
            "enum": [
              ".",
              ".."
            ]
          }
        },
        "scopes": {
          "type": "object"
        },
        "scopeSchema": {
          "description": "JSON Schema draft 2020-12 for scopes; only local references are allowed.",
          "type": [
            "object",
            "boolean"
          ]
        },
        "expiresInSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "schemaRef": {
          "type": "string"
        },
        "userSchema": {
          "type": [
            "object",
            "boolean"
          ]
        },
        "serverSchema": {
          "type": [
            "object",
            "boolean"
          ]
        }
      }
    },
    "CallRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "args": {
          "type": "array",
          "items": true,
          "default": []
        }
      }
    },
    "CallResponse": {
      "type": "object",
      "required": [
        "result"
      ],
      "properties": {
        "result": true
      }
    },
    "RegistryImport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "token"
      ],
      "properties": {
        "address": {
          "type": "string",
          "format": "uri"
        },
        "token": {
          "type": "string",
          "minLength": 24,
          "writeOnly": true
        },
        "prefix": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]*$"
        }
      }
    },
    "Error": {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "string"
        }
      }
    },
    "SchemaRegistration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "schema"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "schema": {
          "type": [
            "object",
            "boolean"
          ]
        }
      }
    }
  }
}
