{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dixonSolutions/LiveEngine/blob/main/docs/hub-contract.schema.json",
  "title": "LiveEngine Hub Protocol v1",
  "description": "Uniform DTOs for internal handlers and externally hosted hubs. Registration and discovery happen at runtime.",
  "$defs": {
    "HubMode": {
      "type": "string",
      "enum": [
        "internal",
        "external",
        "central"
      ]
    },
    "HubRegistration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}$",
          "not": {
            "enum": [
              ".",
              ".."
            ]
          }
        },
        "mode": {
          "$ref": "#/$defs/HubMode"
        },
        "address": {
          "type": "string",
          "format": "uri"
        },
        "remoteHubId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}$",
          "not": {
            "enum": [
              ".",
              ".."
            ]
          }
        },
        "remoteToken": {
          "type": "string",
          "minLength": 24,
          "writeOnly": true
        },
        "scopes": {
          "type": "object",
          "additionalProperties": true,
          "default": {}
        },
        "auth": {
          "$ref": "#/$defs/AuthDefinition"
        },
        "hosting": {
          "const": "provider",
          "description": "Central hubs only. Runs the hub on this service and returns a hub-scoped credential once, as `credential`, that manages only this hub and its subtree through POST /v1/route."
        },
        "scopeSchema": {
          "description": "JSON Schema draft 2020-12 for scopes; only local references are allowed.",
          "type": [
            "object",
            "boolean"
          ]
        },
        "ttlSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "schemaRef": {
          "type": "string"
        },
        "userSchema": {
          "type": [
            "object",
            "boolean"
          ]
        },
        "serverSchema": {
          "type": [
            "object",
            "boolean"
          ]
        },
        "template": {
          "type": "string"
        },
        "ifAbsent": {
          "type": "boolean",
          "default": false
        },
        "maxHubs": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum immediate children of a local central hub."
        },
        "liveDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "description": "Maximum live registry depth for a central, bounded by the service maximum."
        },
        "channels": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_.-]{1,128}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/LiveChannel"
          }
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "mode"
              ]
            },
            {
              "required": [
                "template"
              ]
            }
          ]
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "external"
              }
            },
            "required": [
              "mode"
            ],
            "not": {
              "required": [
                "template"
              ]
            }
          },
          "then": {
            "required": [
              "address",
              "remoteToken"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "internal"
              }
            },
            "required": [
              "mode"
            ],
            "not": {
              "required": [
                "template"
              ]
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "address"
                  ]
                },
                {
                  "required": [
                    "remoteHubId"
                  ]
                },
                {
                  "required": [
                    "remoteToken"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "HubInfo": {
      "type": "object",
      "required": [
        "id",
        "mode",
        "scopes",
        "remoteHubId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}$",
          "not": {
            "enum": [
              ".",
              ".."
            ]
          }
        },
        "mode": {
          "$ref": "#/$defs/HubMode"
        },
        "address": {
          "type": "string",
          "format": "uri"
        },
        "remoteHubId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}$",
          "not": {
            "enum": [
              ".",
              ".."
            ]
          }
        },
        "scopes": {
          "type": "object"
        },
        "scopeSchema": {
          "description": "JSON Schema draft 2020-12 for scopes; only local references are allowed.",
          "type": [
            "object",
            "boolean"
          ]
        },
        "expiresInSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "schemaRef": {
          "type": "string"
        },
        "userSchema": {
          "type": [
            "object",
            "boolean"
          ]
        },
        "serverSchema": {
          "type": [
            "object",
            "boolean"
          ]
        },
        "maxHubs": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum immediate children of a local central hub."
        },
        "auth": {
          "$ref": "#/$defs/AuthInfo",
          "description": "Only the verifier kind; never any secret."
        },
        "stale": {
          "type": "boolean",
          "description": "True when a refreshed registry no longer lists this imported hub."
        },
        "channels": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_.-]{1,128}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/LiveChannel"
          }
        }
      }
    },
    "AuthDefinition": {
      "description": "Per-hub credential verifier, checked before a ticket is issued. Write-only: secrets are persisted but never returned. Only the kind is published, as HubInfo.auth.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "tokens"
          ],
          "properties": {
            "kind": {
              "const": "token"
            },
            "tokens": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "token"
                ],
                "properties": {
                  "token": {
                    "type": "string",
                    "minLength": 24,
                    "maxLength": 512,
                    "writeOnly": true
                  },
                  "identity": {
                    "type": "string",
                    "minLength": 1
                  },
                  "claims": {
                    "type": "object",
                    "description": "User-defined claims; core never interprets them."
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "secret"
          ],
          "properties": {
            "kind": {
              "const": "hmac"
            },
            "secret": {
              "type": "string",
              "minLength": 32,
              "maxLength": 512,
              "writeOnly": true
            },
            "leewaySeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 300
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "alg"
          ],
          "properties": {
            "kind": {
              "const": "jwt"
            },
            "alg": {
              "enum": [
                "HS256",
                "EdDSA"
              ],
              "description": "Fixed by configuration; the token's own alg header is never trusted."
            },
            "secret": {
              "type": "string",
              "minLength": 32,
              "maxLength": 512,
              "writeOnly": true,
              "description": "HS256 only."
            },
            "publicKey": {
              "type": "string",
              "description": "EdDSA only: 32 raw bytes, base64url without padding."
            },
            "issuer": {
              "type": "string"
            },
            "audience": {
              "type": "string"
            },
            "identityClaim": {
              "type": "string",
              "minLength": 1,
              "default": "sub"
            },
            "leewaySeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 300
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "url"
          ],
          "properties": {
            "kind": {
              "const": "webhook"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "description": "Host must be in LIVEENGINE_ALLOWED_REMOTE_HOSTS."
            },
            "secret": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "writeOnly": true,
              "description": "Sent as a bearer token."
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 100,
              "maximum": 10000,
              "default": 3000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "custom"
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,64}$",
              "description": "A verifier registered with HubService::register_verifier."
            }
          }
        }
      ]
    },
    "AuthInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "token",
            "hmac",
            "jwt",
            "webhook",
            "custom"
          ]
        }
      }
    },
    "CallRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "args": {
          "type": "array",
          "items": true,
          "default": []
        }
      }
    },
    "CallResponse": {
      "type": "object",
      "required": [
        "result"
      ],
      "properties": {
        "result": true
      }
    },
    "RegistryImport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "token"
      ],
      "properties": {
        "address": {
          "type": "string",
          "format": "uri"
        },
        "token": {
          "type": "string",
          "minLength": 24,
          "writeOnly": true
        },
        "prefix": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]*$"
        },
        "refreshSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    },
    "Error": {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "string"
        }
      }
    },
    "SchemaRegistration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "schema"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "schema": {
          "type": [
            "object",
            "boolean"
          ]
        }
      }
    },
    "HubTemplate": {
      "type": "object",
      "required": [
        "name",
        "mode"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/HubMode"
        },
        "address": {
          "type": "string",
          "format": "uri"
        },
        "remoteHubId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}$",
          "not": {
            "enum": [
              ".",
              ".."
            ]
          }
        },
        "remoteToken": {
          "type": "string",
          "minLength": 24,
          "writeOnly": true
        },
        "scopes": {
          "type": "object",
          "additionalProperties": true,
          "default": {}
        },
        "auth": {
          "$ref": "#/$defs/AuthDefinition"
        },
        "hosting": {
          "const": "provider",
          "description": "Central hubs only. Runs the hub on this service and returns a hub-scoped credential once, as `credential`, that manages only this hub and its subtree through POST /v1/route."
        },
        "scopeSchema": {
          "description": "JSON Schema draft 2020-12 for scopes; only local references are allowed.",
          "type": [
            "object",
            "boolean"
          ]
        },
        "ttlSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "schemaRef": {
          "type": "string"
        },
        "userSchema": {
          "type": [
            "object",
            "boolean"
          ]
        },
        "serverSchema": {
          "type": [
            "object",
            "boolean"
          ]
        },
        "maxHubs": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum immediate children of a local central hub."
        }
      },
      "additionalProperties": false
    },
    "RouteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "op"
      ],
      "properties": {
        "path": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string"
          }
        },
        "op": {
          "enum": [
            "get",
            "list",
            "register",
            "delete",
            "call",
            "tree",
            "ticket",
            "watchTicket",
            "authorize",
            "discover",
            "pair"
          ]
        },
        "body": {
          "type": "object"
        }
      }
    },
    "TreeBranch": {
      "type": "object",
      "required": [
        "hub",
        "status"
      ],
      "properties": {
        "hub": {
          "$ref": "#/$defs/HubInfo"
        },
        "status": {
          "enum": [
            "ok",
            "error"
          ]
        },
        "hubs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TreeBranch"
          }
        }
      }
    },
    "SchemaDefinition": {
      "type": "object",
      "required": [
        "ref",
        "schema"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+@[A-Za-z0-9._-]+$"
        },
        "schema": {
          "type": [
            "object",
            "boolean"
          ]
        }
      }
    },
    "RegistryExport": {
      "type": "object",
      "required": [
        "protocol",
        "hubs",
        "schemas"
      ],
      "properties": {
        "protocol": {
          "const": "liveengine.hub/v1"
        },
        "hubs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HubInfo"
          }
        },
        "schemas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SchemaDefinition"
          }
        }
      }
    },
    "TreeResponse": {
      "type": "object",
      "required": [
        "status",
        "hubs"
      ],
      "properties": {
        "status": {
          "const": "ok"
        },
        "hubs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TreeBranch"
          }
        }
      }
    },
    "WatchRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "depth"
      ],
      "properties": {
        "path": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 16
        },
        "depth": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "LinkDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "address",
        "remoteToken",
        "hubId",
        "userId",
        "serverId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}$"
        },
        "address": {
          "type": "string",
          "format": "uri"
        },
        "remoteToken": {
          "type": "string",
          "minLength": 24,
          "writeOnly": true
        },
        "hubId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "serverId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "localHubId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}$"
        },
        "localRoom": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "dependentRequired": {
        "localHubId": [
          "localRoom"
        ],
        "localRoom": [
          "localHubId"
        ]
      }
    },
    "LinkInfo": {
      "type": "object",
      "required": [
        "id",
        "hubId",
        "userId",
        "serverId",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "hubId": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "serverId": {
          "type": "string"
        },
        "status": {
          "enum": [
            "connecting",
            "connected",
            "unreachable"
          ]
        }
      }
    },
    "DiscoverRequest": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 16
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "enum": [
            "hub",
            "peer",
            "any"
          ]
        },
        "requirements": {
          "type": [
            "object",
            "array",
            "null"
          ]
        }
      }
    },
    "PairRequest": {
      "type": "object",
      "required": [
        "subject",
        "target"
      ],
      "properties": {
        "path": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 16
        },
        "subject": {
          "type": "object",
          "required": [
            "kind",
            "id",
            "scopes"
          ],
          "properties": {
            "kind": {
              "enum": [
                "peer",
                "hub"
              ]
            },
            "id": {
              "type": "string"
            },
            "scopes": {
              "type": "object"
            },
            "credential": {
              "type": "string",
              "writeOnly": true
            }
          }
        },
        "target": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "peer",
                "hub",
                "any"
              ]
            },
            "id": {
              "type": "string"
            },
            "requirements": {
              "type": [
                "object",
                "array",
                "null"
              ]
            }
          }
        },
        "waitMs": {
          "type": "integer",
          "minimum": 0,
          "description": "For peer subjects targeting peer or any; capped by LIVEENGINE_MAX_PAIR_WAIT_MS."
        }
      }
    },
    "LinkCredentialResponse": {
      "type": "object",
      "required": [
        "token"
      ],
      "properties": {
        "token": {
          "type": "string",
          "writeOnly": true
        }
      },
      "additionalProperties": false
    },
    "TicketRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userId",
        "serverId"
      ],
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1
        },
        "serverId": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "peer",
            "service"
          ],
          "default": "peer"
        },
        "credential": {
          "type": "string",
          "writeOnly": true
        },
        "verified": {
          "type": "string",
          "writeOnly": true,
          "description": "Single-use authorization receipt bound to this ticket request."
        }
      }
    },
    "TicketResponse": {
      "type": "object",
      "required": [
        "ticket",
        "url",
        "expiresAt"
      ],
      "properties": {
        "ticket": {
          "type": "string",
          "writeOnly": true
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "expiresAt": {
          "type": "integer"
        }
      }
    },
    "WatchTicketResponse": {
      "type": "object",
      "required": [
        "ticket",
        "expiresAt"
      ],
      "properties": {
        "ticket": {
          "type": "string",
          "writeOnly": true
        },
        "expiresAt": {
          "type": "integer"
        }
      }
    },
    "LiveEnvelope": {
      "type": "object",
      "required": [
        "v",
        "type",
        "channel",
        "seq",
        "payload"
      ],
      "properties": {
        "v": {
          "type": "number",
          "description": "LiveClient sends 1."
        },
        "type": {
          "type": "string",
          "description": "Application type; auth, welcome, presence, error, link.* and signal.* are reserved."
        },
        "channel": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "from": {
          "type": "string",
          "readOnly": true
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "payload": {}
      }
    },
    "LiveChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delivery"
      ],
      "properties": {
        "schemaRef": {
          "type": "string"
        },
        "delivery": {
          "enum": [
            "reliable",
            "lossy"
          ]
        },
        "maxRate": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "x-routes": {
    "/health": [
      "GET"
    ],
    "/v1/ping": [
      "GET"
    ],
    "/v1/contract": [
      "GET"
    ],
    "/v1/contract/schema": [
      "GET"
    ],
    "/v1/schemas": [
      "GET",
      "POST"
    ],
    "/v1/schemas/{id}": [
      "GET",
      "DELETE"
    ],
