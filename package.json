{
  "name": "@dixonsolutions/liveengine",
  "version": "0.2.4",
  "description": "Rust live matchmaking with embedded and standalone hub hosting, custom scopes, and authenticated remote hub registries",
  "main": "lib/index.js",
  "types": "index.d.ts",
  "license": "MIT",
  "author": "dixonSolutions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dixonSolutions/LiveEngine.git"
  },
  "homepage": "https://github.com/dixonSolutions/LiveEngine#readme",
  "bugs": {
    "url": "https://github.com/dixonSolutions/LiveEngine/issues"
  },
  "keywords": [
    "matchmaking",
    "pairing",
    "hub",
    "registry",
    "rust",
    "napi",
    "hosting",
    "docker"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "lib",
    "lib/live-client.mjs",
    "lib/live-client.d.mts",
    "lib/hub-api.mjs",
    "lib/hub-api.d.mts",
    "native/*.node",
    "native/liveengine-hub.*",
    "src/**/*.rs",
    "Cargo.toml",
    "Cargo.lock",
    "build.rs",
    "scripts",
    "bin",
    "index.d.ts",
    "README.md",
    "LICENSE",
    "docs/hub-contract.schema.json",
    "examples/*.rs",
    "examples/frameworks",
    "examples/user-hub",
    "docs/*.md"
  ],
  "scripts": {
    "install": "node scripts/install.js",
    "build": "node scripts/build.js",
    "build:debug": "node scripts/build.js --debug",
    "build:hub": "node scripts/build-hub.js",
    "test": "node --test test/engine.test.js test/math-game.test.js test/hub-client.test.js test/live-client.test.mjs test/hub-api.test.mjs",
    "test:rust": "cargo test --locked",
    "test:all": "npm run test:rust && npm test && npm run test:integration",
    "bench": "node bench/bench.js",
    "example": "node examples/math-game/server.js",
    "hub": "node bin/liveengine-hub.js",
    "test:integration": "node --test integrations/gogh-strike/bridge.test.mjs integrations/gogh-strike/bridge-live.test.mjs",
    "test:e2e": "node integrations/gogh-strike/live-e2e.mjs",
    "dev:gogh": "node scripts/dev-gogh.mjs",
    "docs:dev": "cd docs-site && npx mint@latest dev",
    "docs:validate": "cd docs-site && npx mint@latest validate && npx mint@latest broken-links"
  },
  "bin": {
    "liveengine-hub": "bin/liveengine-hub.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./hubs": {
      "types": "./lib/hubs.d.ts",
      "require": "./lib/hubs.js",
      "default": "./lib/hubs.js"
    },
    "./live-client": {
      "types": "./lib/live-client.d.mts",
      "import": "./lib/live-client.mjs",
      "default": "./lib/live-client.mjs"
    },
    "./hub-api": {
      "types": "./lib/hub-api.d.mts",
      "import": "./lib/hub-api.mjs",
      "default": "./lib/hub-api.mjs"
    },
    "./package.json": "./package.json"
  }
}
