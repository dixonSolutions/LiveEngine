diff --git a/src/liveengine-matchmaking.js b/src/liveengine-matchmaking.js
new file mode 100644
index 0000000..0f481ac
--- /dev/null
+++ b/src/liveengine-matchmaking.js
@@ -0,0 +1,267 @@
+const USER_KEY = 'gogh-strike-liveengine-user';
+const CREDENTIAL_KEY = 'gogh-strike-liveengine-credential';
+const HUB_KEY = 'gogh-strike-liveengine-hub-api';
+const DEFAULT_API = '/api/liveengine';
+const FIND_WAIT_MS = 30_000;
+const PING_EVERY_MS = 5_000;
+let heartbeat;
+let session;
+
+function randomToken() {
+  try {
+    const bytes = new Uint8Array(12);
+    crypto.getRandomValues(bytes);
+    return Array.from(bytes, byte => byte.toString(16).padStart(2, '0')).join('');
+  } catch {
+    return Math.random().toString(36).slice(2).padEnd(24, '0').slice(0, 24);
+  }
+}
+
+// One id per tab, so two tabs of the same browser are two players.
+function localUserId() {
+  try {
+    let id = sessionStorage.getItem(USER_KEY);
+    if (!id) {
+      id = `gogh-${randomToken()}`;
+      sessionStorage.setItem(USER_KEY, id);
+    }
+    return id;
+  } catch {
+    return `gogh-${randomToken()}`;
+  }
+}
+
+export async function getLiveEngineStatus() {
+  const response = await fetch('/api/liveengine/status', {headers: {Accept: 'application/json'}});
+  if (!response.ok) throw new Error(`Local matchmaking bridge is unavailable (${response.status})`);
+  return response.json();
+}
+
+// A credential for a hub that sets `auth`, if the player has one.
+function storedCredential() {
+  try { return localStorage.getItem(CREDENTIAL_KEY) || undefined; }
+  catch { return undefined; }
+}
+
+export async function joinLiveEngineMatch(config) {
+  const userId = localUserId();
+  if (session?.state === 'open') return {ok: true, userId, serverId: session.room, peers: session.peers().length};
+  // The bridge serves LiveClient. Pairing, tickets, retry and reconnect all happen inside it.
+  const {connectLive} = await import('/liveengine/live-client.mjs');
+  const client = await connectLive({
+    pairUrl: `${DEFAULT_API}/pair`, renewUrl: `${DEFAULT_API}/renew`,
+    body: {userId, team: config.team, role: config.role}, credential: storedCredential(),
+    // Player state goes to everyone; over a peer pairing it should use the data channels.
+    directBroadcast: true,
+  });
+  session = client;
+  heartbeat = setInterval(() => {
+    client.heartbeat().catch(() => {});
+  }, 60_000);
+  return {ok: true, userId, serverId: client.room, peers: client.peers().length};
+}
+
+export function getLiveSession() { return session; }
+
+// ---- Play online: a hub API anywhere, then peer-to-peer matchmaking ----
+// Everything the "Play online" panel shows comes from this state. Pairing, tickets, retries and the
+// WebRTC link are LiveClient and connectLive, loaded from the hub API itself, so the page needs no copy.
+
+const online = {phase: 'idle', address: '', base: '', pingMs: null, hubPingMs: null, waiting: null, seats: null,
+  hubs: [], hubsLive: false, match: null, error: ''};
+const onlineListeners = new Set();
+let pinger;
+let hubWatch;
+let search;
+
+function setOnline(change) {
+  Object.assign(online, change);
+  const snapshot = {...online, hubs: online.hubs.map(hub => ({...hub})), match: online.match && {...online.match}};
+  for (const listener of [...onlineListeners]) listener(snapshot);
+}
+
+export function onOnlineChange(listener) {
+  onlineListeners.add(listener);
+  return () => onlineListeners.delete(listener);
+}
+
+/** The address the panel starts with: the last one used, else this page's own origin. */
+export function savedHubAddress() {
+  try { return localStorage.getItem(HUB_KEY) || location.origin; }
+  catch { return location.origin; }
+}
+
+/** An origin alone means the standard route; an address with a path is used as typed. */
+export function hubApiBase(address) {
+  let text = String(address || '').trim();
+  if (!text) throw new Error('Type the hub API address first, for example http://192.168.1.20:8967');
+  if (!/^[a-z][a-z0-9+.-]*:\/\//i.test(text)) text = `${location.protocol}//${text}`;
+  let url;
+  try { url = new URL(text); }
+  catch { throw new Error(`"${address}" is not an address. Use the form http://host:port.`); }
+  if (!['http:', 'https:'].includes(url.protocol)) throw new Error('The hub API address must start with http:// or https://.');
+  url.search = '';
+  url.hash = '';
+  const path = url.pathname.replace(/\/+$/, '');
+  return `${url.origin}${path || DEFAULT_API}`;
+}
+
+const importClient = base => import(`${base}/live-client.mjs`);
+
+async function readJson(response) {
+  try { return await response.json(); } catch { return null; }
+}
+
+function closeWatchers() {
+  clearInterval(pinger);
+  pinger = undefined;
+  hubWatch?.close();
+  hubWatch = undefined;
+}
+
+async function pingOnce(base) {
+  const started = performance.now();
+  try {
+    const response = await fetch(`${base}/ping`, {headers: {Accept: 'application/json'}, signal: AbortSignal.timeout(6000)});
+    const body = await readJson(response);
+    if (!response.ok || !body) throw new Error(`HTTP ${response.status}`);
+    if (online.base !== base) return;
+    setOnline({pingMs: Math.max(1, Math.round(performance.now() - started)), hubPingMs: body.hubPingMs ?? null,
+      waiting: body.waiting ?? 0, seats: body.seats ?? 0, error: online.error.startsWith('Lost contact') ? '' : online.error});
+  } catch {
+    if (online.base !== base) return;
+    setOnline({pingMs: null, error: 'Lost contact with the hub API. The page keeps trying; check that the server is still running.'});
+  }
+}
+
+async function startHubList(base) {
+  try {
+    const {watchHubs} = await importClient(base);
+    const watch = await watchHubs({watchUrl: `${base}/watch`, body: {depth: 2}});
+    if (online.base !== base) return watch.close();
+    hubWatch = watch;
+    const show = list => setOnline({hubs: list, hubsLive: true});
+    watch.on('change', show);
+    watch.on('close', () => { if (hubWatch === watch) setOnline({hubsLive: false}); });
+    show(watch.hubs());
+  } catch {
+    if (online.base === base) setOnline({hubs: [], hubsLive: false});
+  }
+}
+
+/** Check that `address` is a hub API, then keep its ping, waiting count and hub list live. */
+export async function connectOnline(address) {
+  await disconnectOnline();
+  let base;
+  try { base = hubApiBase(address); }
+  catch (error) { setOnline({phase: 'idle', error: error.message}); throw error; }
+  setOnline({phase: 'connecting', address, base: '', error: '', pingMs: null, hubPingMs: null, waiting: null, seats: null, hubs: [], hubsLive: false});
+  let status;
+  try {
+    const response = await fetch(`${base}/status`, {headers: {Accept: 'application/json'}, signal: AbortSignal.timeout(8000)});
+    status = await readJson(response);
+    if (!response.ok || typeof status?.hubId !== 'string') {
+      throw Object.assign(new Error(`${new URL(base).host} answered, but not as a hub API (HTTP ${response.status}). Check the address, including any path.`), {reported: true});
+    }
+  } catch (error) {
+    const message = error.reported ? error.message
+      : `Could not reach a hub API at ${base}. Check the address and that the server is running, and that it allows this page (${location.origin}) as an origin.`;
+    setOnline({phase: 'idle', error: message});
+    throw new Error(message);
+  }
+  if (!status.configured) {
+    const message = `The hub API at ${new URL(base).host} is running but has no hub configured. Ask its owner to set the hub address and token.`;
+    setOnline({phase: 'idle', error: message});
+    throw new Error(message);
+  }
+  try { localStorage.setItem(HUB_KEY, address.trim()); } catch { /* the address is just not remembered */ }
+  setOnline({phase: 'connected', base, hubId: status.hubId});
+  await pingOnce(base);
+  pinger = setInterval(() => pingOnce(base), PING_EVERY_MS);
+  startHubList(base);
+  return {base, hubId: status.hubId};
+}
+
+export async function disconnectOnline() {
+  await cancelFind();
+  if (online.phase === 'matched') leaveLiveEngineMatch();
+  closeWatchers();
+  if (online.phase !== 'idle') setOnline({phase: 'idle', base: '', match: null, hubs: [], hubsLive: false, pingMs: null, waiting: null});
+}
+
+function findFailure(error, base) {
+  const host = new URL(base).host;
+  if (error.status === 408) return 'No other player arrived in time. Press Find match again, or ask a friend to press it too.';
+  if (error.status === 403) return `${host} refused your credential: ${error.message}. Check the credential saved for this game.`;
+  if (error.status === 429) return 'Too many requests from this device. Wait a minute, then press Find match again.';
+  if (error.status === 409) return 'You are already searching from another tab. Close it or press Find match again.';
+  if (error.status >= 500 || error.status === 503) return `The hub API at ${host} could not reach its hub (${error.message}). Try again shortly.`;
+  if (error.status) return `${host} said: ${error.message}`;
+  return `Lost contact with ${host} while matching. Check that it is still running, then press Find match again.`;
+}
+
+function describeMatch(client) {
+  const peers = client.peers();
+  const kinds = peers.map(peer => client.transportOf(peer));
+  const direct = peers.length > 0 && kinds.every(kind => kind === 'direct');
+  const connection = peers.length === 0 ? 'waiting' : direct ? 'direct' : kinds.includes('direct') ? 'mixed' : 'relay';
+  return {peers, connection, room: client.room, id: client.id};
+}
+
+/** Pair with another player through the hub API (waiting up to FIND_WAIT_MS), then connect. */
+export async function findOnlineMatch(config) {
+  if (online.phase !== 'connected') throw new Error('Press Connect first.');
+  const base = online.base;
+  const controller = new AbortController();
+  const userId = localUserId();
+  search = controller;
+  setOnline({phase: 'searching', error: '', match: null});
+  try {
+    const {connectLive} = await importClient(base);
+    const client = await connectLive({
+      pairUrl: `${base}/pair`, renewUrl: `${base}/renew`,
+      body: {userId, team: config.team, role: config.role, waitMs: FIND_WAIT_MS}, credential: storedCredential(),
+      directBroadcast: true, fetch: (url, init) => fetch(url, {...init, signal: controller.signal}),
+    });
+    if (controller.signal.aborted) { client.close(); return null; }
+    session = client;
+    clearInterval(heartbeat);
+    heartbeat = setInterval(() => {
+      client.heartbeat().catch(() => {});
+    }, 60_000);
+    const refresh = () => { if (session === client) setOnline({match: describeMatch(client)}); };
+    client.on('presence', refresh);
+    client.on('transport', refresh);
+    client.on('close', () => { if (session === client && online.phase === 'matched') setOnline({phase: 'connected', match: null, error: 'The match connection closed. Press Find match to play again.'}); });
+    setOnline({phase: 'matched', match: describeMatch(client)});
+    return {userId, serverId: client.room};
+  } catch (error) {
+    if (controller.signal.aborted) return null;
+    const message = findFailure(error, base);
+    setOnline({phase: 'connected', error: message});
+    throw new Error(message);
+  } finally {
+    if (search === controller) search = undefined;
+  }
+}
+
+/** Stop searching: the pairing request is dropped and the seat is released. */
+export async function cancelFind() {
+  if (!search) return;
+  search.abort();
+  search = undefined;
+  setOnline({phase: 'connected', error: ''});
+}
+
+export function hasLiveMatch() { return session?.state === 'open'; }
+
+export function leaveLiveEngineMatch() {
+  clearInterval(heartbeat);
+  const client = session;
+  session = undefined;
+  client?.leave().catch(() => {});
+  client?.close();
+  if (online.phase === 'matched') setOnline({phase: 'connected', match: null});
+}
+
+window.addEventListener('pagehide', leaveLiveEngineMatch);
