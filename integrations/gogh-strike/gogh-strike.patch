--- /dev/null
+++ b/tests/liveengine-net.test.js
@@ -0,0 +1,125 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  INTERPOLATION_DELAY, LIVE_CHANNELS, LIVE_SCHEMAS, RemoteTrack, applyRemoteState, decodeEvent, decodeState,
+  encodeDown, encodeHit, encodeShot, encodeState, pickRemoteSlot,
+} from '../src/liveengine-net.js';
+
+const vec = (x = 0, y = 0, z = 0) => ({x, y, z, set(a, b, c) { this.x = a; this.y = b; this.z = c; }});
+const actor = (extra = {}) => ({
+  team: 1, role: 'vanguard', position: vec(1.23456, 2, -3.5), velocity: vec(1, 0, -2), yaw: .5, pitch: -.25,
+  health: 120.04, alive: true, crouched: false, sprinting: true, weaponId: 'rifle', ...extra,
+});
+const schemaOf = id => LIVE_SCHEMAS.find(entry => entry.id === id).schema;
+// The hub validates the real JSON Schema; this checks the DTO and the schema name the same keys.
+const keysMatch = (schema, dto) => {
+  assert.deepEqual(schema.required.filter(key => !(key in dto)), []);
+  assert.deepEqual(Object.keys(dto).filter(key => !(key in schema.properties)), []);
+};
+
+test('schemas and channels name each other and use unique versioned ids', () => {
+  const refs = LIVE_SCHEMAS.map(entry => `${entry.id}@${entry.version}`);
+  assert.equal(new Set(refs).size, refs.length);
+  for (const channel of Object.values(LIVE_CHANNELS)) assert.ok(refs.includes(channel.schemaRef));
+  assert.equal(LIVE_CHANNELS.state.delivery, 'lossy');
+  assert.equal(LIVE_CHANNELS.event.delivery, 'reliable');
+});
+
+test('player state encodes to the schema keys, rounds, and survives a decode', () => {
+  const dto = encodeState(actor(), 7);
+  keysMatch(schemaOf('gogh-strike.state'), dto);
+  assert.equal(dto.x, 1.235);
+  assert.equal(dto.health, 120);
+  assert.equal(dto.weapon, 'rifle');
+  assert.deepEqual(decodeState(JSON.parse(JSON.stringify(dto))), {...dto});
+});
+
+test('state decoding refuses malformed or hostile payloads', () => {
+  const good = encodeState(actor(), 1);
+  for (const bad of [null, 'x', {}, {...good, n: -1}, {...good, n: 1.5}, {...good, team: 2}, {...good, x: NaN}, {...good, x: '1'}, {...good, alive: 1}, {...good, role: ''}]) {
+    assert.equal(decodeState(bad), null);
+  }
+  const clamped = decodeState({...good, health: 99999, vx: 'fast', crouched: 'yes', weapon: 5});
+  assert.equal(clamped.health, 1000);
+  assert.equal(clamped.vx, 0);
+  assert.equal(clamped.crouched, false);
+  assert.equal(clamped.weapon, undefined);
+});
+
+test('events encode to the schema and decode back; unknown kinds and bad fields are refused', () => {
+  const shot = encodeShot('rifle', vec(1, 2, 3), vec(0, 0, -1));
+  const hit = encodeHit('gogh-abc', 31.456, true, 'rifle');
+  const down = encodeDown(undefined);
+  assert.deepEqual(shot, {kind: 'shot', weapon: 'rifle', origin: [1, 2, 3], dir: [0, 0, -1]});
+  assert.deepEqual(hit, {kind: 'hit', target: 'gogh-abc', damage: 31.46, headshot: true, weapon: 'rifle'});
+  assert.deepEqual(down, {kind: 'down', by: null});
+  const branches = schemaOf('gogh-strike.event').oneOf;
+  for (const dto of [shot, hit, down]) {
+    const branch = branches.find(entry => entry.properties.kind.const === dto.kind);
+    keysMatch(branch, dto);
+    assert.deepEqual(decodeEvent(JSON.parse(JSON.stringify(dto))), dto);
+  }
+  for (const bad of [null, {}, {kind: 'nuke'}, {...shot, origin: [1, 2]}, {...shot, dir: [0, 0, NaN]}, {...hit, damage: -1}, {...hit, damage: 5000}, {...hit, target: 1}, {kind: 'down', by: 3}]) {
+    assert.equal(decodeEvent(bad), null);
+  }
+});
+
+const snapshot = (n, x, extra = {}) => ({...decodeState(encodeState(actor({position: vec(x, 0, 0), velocity: vec(0, 0, 0), yaw: 0}), n)), ...extra});
+
+test('a remote track is drawn slightly in the past, between two snapshots', () => {
+  const track = new RemoteTrack();
+  track.push(snapshot(1, 0), 10);
+  track.push(snapshot(2, 4), 10.1);
+  const mid = track.sample(10.05 + INTERPOLATION_DELAY);
+  assert.ok(Math.abs(mid.x - 2) < 1e-9);
+  assert.equal(track.sample(9 + INTERPOLATION_DELAY).x, 0);
+});
+
+test('out-of-order and repeated snapshots are dropped', () => {
+  const track = new RemoteTrack();
+  assert.equal(track.push(snapshot(5, 1), 1), true);
+  assert.equal(track.push(snapshot(4, 9), 1.1), false);
+  assert.equal(track.push(snapshot(5, 9), 1.1), false);
+  assert.equal(track.sample(2).x, 1);
+});
+
+test('extrapolation is capped and a respawn jump snaps instead of sliding', () => {
+  const track = new RemoteTrack();
+  track.push(snapshot(1, 0, {vx: 10}), 0);
+  assert.ok(Math.abs(track.sample(0 + INTERPOLATION_DELAY + 5).x - 2.5) < 1e-9);
+  track.push(snapshot(2, 50), 1);
+  assert.equal(track.sample(.5 + INTERPOLATION_DELAY).x, 50);
+  assert.equal(new RemoteTrack().sample(1), null);
+});
+
+test('yaw turns the short way round', () => {
+  const track = new RemoteTrack();
+  track.push(snapshot(1, 0, {yaw: 3.1}), 0);
+  track.push(snapshot(2, 0, {yaw: -3.1}), 1);
+  const yaw = track.sample(.5 + INTERPOLATION_DELAY).yaw;
+  assert.ok(Math.abs(Math.abs(yaw) - Math.PI) < .05);
+});
+
+test('a remote player takes a free teammate with its role, else any free teammate', () => {
+  const roster = [actor({id: 0, role: 'vanguard', isPlayer: true}), actor({id: 1, role: 'anchor'}), actor({id: 2, role: 'marksman'}), actor({id: 3, role: 'anchor', team: 0})];
+  assert.equal(pickRemoteSlot(roster, {team: 1, role: 'marksman'}).id, 2);
+  assert.equal(pickRemoteSlot(roster, {team: 1, role: 'vanguard'}).id, 1);
+  roster[1].remote = true;
+  assert.equal(pickRemoteSlot(roster, {team: 1, role: 'anchor'}).id, 2);
+  roster[2].remote = true;
+  assert.equal(pickRemoteSlot(roster, {team: 1, role: 'anchor'}), null);
+});
+
+test('applying a state moves the stand-in actor and ignores unknown weapons', () => {
+  const stand = actor({weaponId: 'pistol', alive: false});
+  const state = decodeState({...encodeState(actor(), 3), health: 55});
+  applyRemoteState(stand, state, id => id === 'rifle');
+  assert.deepEqual([stand.position.x, stand.position.y, stand.position.z], [1.235, 2, -3.5]);
+  assert.deepEqual([stand.velocity.x, stand.velocity.z], [1, -2]);
+  assert.equal(stand.alive, true);
+  assert.equal(stand.health, 55);
+  assert.equal(stand.sprinting, true);
+  assert.equal(stand.weaponId, 'rifle');
+  applyRemoteState(stand, {...state, weapon: 'laser'}, id => id === 'rifle');
+  assert.equal(stand.weaponId, 'rifle');
+});
