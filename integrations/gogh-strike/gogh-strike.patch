@@ -0,0 +1,149 @@
+// Gogh Strike's LiveEngine data: the DTOs it registers as schemas, the channels that carry them,
+// and the mapping between those DTOs and game state. No connection, retry or pairing logic is
+// here: LiveClient owns that. This file has no DOM or three.js dependency.
+
+export const STATE_HZ = 20;
+export const INTERPOLATION_DELAY = .1;
+const MAX_EXTRAPOLATION = .25;
+const TELEPORT_DISTANCE = 8;
+
+const number = {type: 'number'};
+const vector = {type: 'array', items: number, minItems: 3, maxItems: 3};
+const text = {type: 'string', minLength: 1, maxLength: 64};
+
+// Registered by the bridge. The hub rejects frames that do not match.
+export const LIVE_SCHEMAS = [
+  {id: 'gogh-strike.state', version: '1', schema: {
+    type: 'object', additionalProperties: false,
+    required: ['n', 'team', 'role', 'x', 'y', 'z', 'yaw', 'pitch', 'alive'],
+    properties: {
+      n: {type: 'integer', minimum: 0}, team: {enum: [0, 1]}, role: text,
+      x: number, y: number, z: number, yaw: number, pitch: number, vx: number, vz: number,
+      health: {type: 'number', minimum: 0, maximum: 1000}, alive: {type: 'boolean'},
+      crouched: {type: 'boolean'}, sprinting: {type: 'boolean'}, weapon: text,
+    },
+  }},
+  {id: 'gogh-strike.event', version: '1', schema: {
+    oneOf: [
+      {type: 'object', additionalProperties: false, required: ['kind', 'weapon', 'origin', 'dir'],
+        properties: {kind: {const: 'shot'}, weapon: text, origin: vector, dir: vector}},
+      {type: 'object', additionalProperties: false, required: ['kind', 'target', 'damage', 'headshot', 'weapon'],
+        properties: {kind: {const: 'hit'}, target: text, damage: {type: 'number', minimum: 0, maximum: 1000}, headshot: {type: 'boolean'}, weapon: text}},
+      {type: 'object', additionalProperties: false, required: ['kind', 'by'],
+        properties: {kind: {const: 'down'}, by: {type: ['string', 'null'], maxLength: 64}}},
+    ],
+  }},
+];
+
+// Player state is lossy: a newer snapshot replaces a lost one. Events must all arrive.
+export const LIVE_CHANNELS = {
+  state: {schemaRef: 'gogh-strike.state@1', delivery: 'lossy', maxRate: 40},
+  event: {schemaRef: 'gogh-strike.event@1', delivery: 'reliable', maxRate: 120},
+};
+
+const finite = value => typeof value === 'number' && Number.isFinite(value);
+const round = (value, places = 3) => Math.round(value * 10 ** places) / 10 ** places;
+const triple = value => Array.isArray(value) && value.length === 3 && value.every(finite);
+const flag = value => value === true;
+
+export function encodeState(actor, n) {
+  return {
+    n, team: actor.team, role: actor.role,
+    x: round(actor.position.x), y: round(actor.position.y), z: round(actor.position.z),
+    yaw: round(actor.yaw), pitch: round(actor.pitch), vx: round(actor.velocity.x), vz: round(actor.velocity.z),
+    health: Math.max(0, round(actor.health, 1)), alive: !!actor.alive,
+    crouched: !!actor.crouched, sprinting: !!actor.sprinting, weapon: actor.weaponId,
+  };
+}
+
+// Anything arriving from a peer is checked again here: the hub validates, but a direct
+// WebRTC frame never touches the hub.
+export function decodeState(payload) {
+  if (!payload || typeof payload !== 'object') return null;
+  const {n, team, role, x, y, z, yaw, pitch, alive} = payload;
+  if (!Number.isInteger(n) || n < 0 || (team !== 0 && team !== 1) || typeof role !== 'string' || !role || role.length > 64) return null;
+  if (![x, y, z, yaw, pitch].every(finite) || typeof alive !== 'boolean') return null;
+  return {
+    n, team, role, x, y, z, yaw, pitch, alive,
+    vx: finite(payload.vx) ? payload.vx : 0, vz: finite(payload.vz) ? payload.vz : 0,
+    health: finite(payload.health) ? Math.min(1000, Math.max(0, payload.health)) : undefined,
+    crouched: flag(payload.crouched), sprinting: flag(payload.sprinting),
+    weapon: typeof payload.weapon === 'string' ? payload.weapon : undefined,
+  };
+}
+
+export const encodeShot = (weapon, origin, dir) => ({kind: 'shot', weapon, origin: [origin.x, origin.y, origin.z].map(v => round(v)), dir: [dir.x, dir.y, dir.z].map(v => round(v, 4))});
+export const encodeHit = (target, damage, headshot, weapon) => ({kind: 'hit', target, damage: round(damage, 2), headshot: !!headshot, weapon});
+export const encodeDown = by => ({kind: 'down', by: by ?? null});
+
+export function decodeEvent(payload) {
+  if (!payload || typeof payload !== 'object') return null;
+  if (payload.kind === 'shot') {
+    return typeof payload.weapon === 'string' && triple(payload.origin) && triple(payload.dir)
+      ? {kind: 'shot', weapon: payload.weapon, origin: payload.origin, dir: payload.dir} : null;
+  }
+  if (payload.kind === 'hit') {
+    return typeof payload.target === 'string' && finite(payload.damage) && payload.damage >= 0 && payload.damage <= 1000 && typeof payload.weapon === 'string'
+      ? {kind: 'hit', target: payload.target, damage: payload.damage, headshot: flag(payload.headshot), weapon: payload.weapon} : null;
+  }
+  if (payload.kind === 'down') {
+    return payload.by === null || typeof payload.by === 'string' ? {kind: 'down', by: payload.by} : null;
+  }
+  return null;
+}
+
+const wrap = angle => Math.atan2(Math.sin(angle), Math.cos(angle));
+
+// Remote players arrive at an uneven rate, so draw them slightly in the past between two
+// snapshots. Out-of-order snapshots are dropped; a large jump (a respawn) snaps instead of sliding.
+export class RemoteTrack {
+  constructor() { this.snapshots = []; this.last = -1; }
+
+  push(state, now) {
+    if (state.n <= this.last) return false;
+    this.last = state.n;
+    this.snapshots.push({...state, at: now});
+    if (this.snapshots.length > 8) this.snapshots.shift();
+    return true;
+  }
+
+  sample(now) {
+    const list = this.snapshots, target = now - INTERPOLATION_DELAY;
+    if (!list.length) return null;
+    const newest = list.at(-1);
+    if (target >= newest.at) {
+      const ahead = Math.min(MAX_EXTRAPOLATION, target - newest.at);
+      return {...newest, x: newest.x + newest.vx * ahead, z: newest.z + newest.vz * ahead};
+    }
+    if (target <= list[0].at) return {...list[0]};
+    let index = 1;
+    while (list[index].at < target) index++;
+    const from = list[index - 1], to = list[index];
+    if (Math.hypot(to.x - from.x, to.z - from.z) > TELEPORT_DISTANCE) return {...to};
+    const k = (target - from.at) / (to.at - from.at), mix = (a, b) => a + (b - a) * k;
+    return {
+      ...to, x: mix(from.x, to.x), y: mix(from.y, to.y), z: mix(from.z, to.z),
+      yaw: from.yaw + wrap(to.yaw - from.yaw) * k, pitch: mix(from.pitch, to.pitch),
+    };
+  }
+}
+
+// An existing actor stands in for the remote player: same team and role if one is free,
+// otherwise any teammate that is neither the local player nor already taken.
+export function pickRemoteSlot(actors, state) {
+  const free = actors.filter(a => a.team === state.team && !a.isPlayer && !a.remote);
+  return free.find(a => a.role === state.role) || free[0] || null;
+}
+
+// Copy a sampled state onto the stand-in actor. `knownWeapon` tells which weapon ids exist.
+export function applyRemoteState(actor, state, knownWeapon = () => true) {
+  actor.position.set(state.x, state.y, state.z);
+  actor.velocity.set(state.vx, 0, state.vz);
+  actor.yaw = state.yaw;
+  actor.pitch = state.pitch;
+  actor.alive = state.alive;
+  if (state.health !== undefined) actor.health = state.health;
+  actor.crouched = state.crouched;
+  actor.sprinting = state.sprinting;
+  if (state.weapon && state.weapon !== actor.weaponId && knownWeapon(state.weapon)) actor.weaponId = state.weapon;
+}
