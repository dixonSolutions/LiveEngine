diff --git a/src/liveengine-matchmaking.js b/src/liveengine-matchmaking.js
new file mode 100644
index 0000000..aa8d8df
--- /dev/null
+++ b/src/liveengine-matchmaking.js
@@ -0,0 +1,61 @@
+const USER_KEY = 'gogh-strike-liveengine-user';
+let activeUser;
+let heartbeat;
+
+function randomToken() {
+  try {
+    const bytes = new Uint8Array(12);
+    crypto.getRandomValues(bytes);
+    return Array.from(bytes, byte => byte.toString(16).padStart(2, '0')).join('');
+  } catch {
+    return Math.random().toString(36).slice(2).padEnd(24, '0').slice(0, 24);
+  }
+}
+
+function localUserId() {
+  try {
+    let id = localStorage.getItem(USER_KEY);
+    if (!id) {
+      id = `gogh-${randomToken()}`;
+      localStorage.setItem(USER_KEY, id);
+    }
+    return id;
+  } catch {
+    return `gogh-${randomToken()}`;
+  }
+}
+
+export async function getLiveEngineStatus() {
+  const response = await fetch('/api/liveengine/status', {headers: {Accept: 'application/json'}});
+  if (!response.ok) throw new Error(`Local matchmaking bridge is unavailable (${response.status})`);
+  return response.json();
+}
+
+export async function joinLiveEngineMatch(config) {
+  const userId = localUserId();
+  const response = await fetch('/api/liveengine/join', {
+    method: 'POST',
+    headers: {'Content-Type': 'application/json', Accept: 'application/json'},
+    body: JSON.stringify({userId, team: config.team, role: config.role}),
+  });
+  const result = await response.json().catch(() => ({}));
+  if (!response.ok) throw new Error(result.error || result.reason || `Matchmaking failed (${response.status})`);
+  activeUser = userId;
+  clearInterval(heartbeat);
+  heartbeat = setInterval(() => {
+    fetch('/api/liveengine/heartbeat', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({userId})}).catch(() => {});
+  }, 60_000);
+  return result;
+}
+
+export function leaveLiveEngineMatch() {
+  clearInterval(heartbeat);
+  if (!activeUser) return;
+  const body = JSON.stringify({userId: activeUser});
+  activeUser = undefined;
+  if (!navigator.sendBeacon('/api/liveengine/leave', new Blob([body], {type: 'application/json'}))) {
+    fetch('/api/liveengine/leave', {method: 'POST', headers: {'Content-Type': 'application/json'}, body, keepalive: true}).catch(() => {});
+  }
+}
+
+window.addEventListener('pagehide', leaveLiveEngineMatch);
