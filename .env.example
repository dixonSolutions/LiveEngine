# Replace both values with separate random secrets. Do not commit real credentials.
LIVEENGINE_TOKEN=replace-with-a-random-token-at-least-24-characters
LIVEENGINE_REMOTE_TOKEN=replace-with-another-random-token-at-least-24-characters
# Set to 0.0.0.0 for LAN/Tailscale access, with a firewall and TLS proxy as appropriate.
LIVEENGINE_LISTEN_IP=127.0.0.1
